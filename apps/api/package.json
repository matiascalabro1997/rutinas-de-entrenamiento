{
  "name": "@rutinas/api",
  "version": "1.0.0",
  "private": true,
  "description": "API Express + Drizzle del gestor de rutinas.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/with-test-env.mjs vitest run --config vitest.config.mts",
    "test:watch": "node scripts/with-test-env.mjs vitest --config vitest.config.mts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:setup:test": "node scripts/with-test-env.mjs drizzle-kit push --config drizzle.config.test.ts && node scripts/with-test-env.mjs tsx src/db/seed.ts",
    "db:migrate:workouts": "node scripts/migrate-workouts.mjs",
    "test:unit": "vitest run --config vitest.unit.config.mts"
  },
  "dependencies": {
    "@rutinas/shared": "*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
