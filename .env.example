# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://usuario:password@localhost:5432/fitness_tracker

# Base de tests, obligatoriamente aislada. apps/api/src/db/index.ts rechaza la
# conexión si esta URL no apunta a la base fitness_tracker_test con el rol
# fitness_tracker_test_runner, y vuelve a verificarlo contra PostgreSQL antes de
# ejecutar cualquier limpieza. No apuntar esto a la base de desarrollo.
TEST_DATABASE_URL=postgres://fitness_tracker_test_runner:password@localhost:5432/fitness_tracker_test

# ─── API ──────────────────────────────────────────────────────────────────────
SERVER_PORT=3001

# Obligatorio en producción; el server no arranca sin él.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Cliente ──────────────────────────────────────────────────────────────────
WEB_PORT=5000
API_PROXY_TARGET=http://localhost:3001

# ─── Sólo producción ──────────────────────────────────────────────────────────
# NODE_ENV=production
# TRUST_PROXY=true                        # detrás de nginx/Fly/Render/Replit
# CORS_ORIGINS=https://tu-dominio.com     # lista separada por comas
# WEB_DIST_PATH=                          # por defecto: apps/web/dist
