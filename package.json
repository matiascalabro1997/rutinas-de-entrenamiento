{
  "name": "fitness-tracker",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite --port 5000 --host 0.0.0.0 --config client/vite.config.ts\"",
    "build": "vite build --config client/vite.config.ts",
    "start": "node dist/server/index.js",
    "test": "env -u DATABASE_URL NODE_ENV=test vitest run --config vitest.config.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx server/db/seed.ts",
    "db:migrate:workouts": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/migrate-workouts.sql",
    "db:setup:test": "env -u DATABASE_URL NODE_ENV=test drizzle-kit push --config drizzle.config.test.ts && env -u DATABASE_URL NODE_ENV=test tsx server/db/seed.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.4",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
